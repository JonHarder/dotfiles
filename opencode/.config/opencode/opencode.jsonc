{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": "ask",
    "websearch": "ask",
    "webfetch": "ask",
    "external_directory": "ask"
  },
  "instructions": [
    "~/.config/opencode/instructions/global.md"
  ]
}